{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/open-source",
      "destination": "/backend-engineer/",
      "permanent": true
    },
    {
      "source": "/open-source/index.html",
      "destination": "/backend-engineer/index.html",
      "permanent": true
    }
  ]
}
